# Required in production
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Product access mode: demo keeps /app public and read-only; connected enables auth and persistence.
LIVING_APP_MODE=demo
# Optional: enables real database and authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: enables a real AI provider
AI_PROVIDER=mock
OPENAI_API_KEY=
# Optional: enables Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Production-only secrets
PREVIEW_SECRET=
CRON_SECRET=
